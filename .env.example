PORT=10000
NODE_ENV=development
LICENSE_SECRET=replace-with-random-secret
ALLOWED_DOMAINS=localhost,example.com
WHATSAPP_TOKEN=replace-with-demo-token
WHATSAPP_PHONE_ID=replace-with-demo-phone-id
WHATSAPP_VERIFY_TOKEN=replace-with-demo-verify-token
WHATSAPP_APP_SECRET=replace-with-demo-webhook-secret
JWT_SECRET=replace-with-demo-jwt-secret
SESSION_SECRET=replace-with-demo-session-secret
ADMIN_PASSWORD=replace-with-demo-admin-password
AI_API_KEY=replace-with-demo-ai-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Paddle Billing — real payments ($29 lifetime tier).
# Webhook secret: Paddle dashboard → Developer Tools → Notifications → your endpoint.
# API key:        Paddle dashboard → Developer Tools → Authentication → API keys.
# Price IDs:      Paddle dashboard → Catalog → Products → Prices (pri_...).
PADDLE_WEBHOOK_SECRET=replace-with-paddle-webhook-secret
PADDLE_API_KEY=replace-with-paddle-api-key
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_PRICE_LIFETIME=pri_replace-with-lifetime-price-id

# License ledger (issued keys) — gitignored, local only.
LICENSE_FILE=data/licenses.json

# Keep real values out of Git.
# Use your deployment provider's secret store for live values.
