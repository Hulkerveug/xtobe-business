# Xtobe-2 — environment (copy to .env, never commit .env)
# ---------------------------------------------------------------
# WhatsApp Cloud API (Meta official) — same gateway as xtobe-1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret (Meta App → Settings → Basic) — enables webhook signature verification.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PATH=/api/webhooks/whatsapp

# Instagram / Facebook (Messenger Platform) — placeholders until App Review clears
INSTAGRAM_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
FACEBOOK_PAGE_TOKEN=

# AI content studio (OpenAI-compatible: OpenAI, Groq, DeepSeek...)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Clinic
CLINIC_NAME=Xtobe Demo Clinic
CLINIC_CURRENCY=AED

# Server
PORT=3000
DB_FILE=data/xtobe2.db

# Anti-clone shield (secure/antiCloneShield.js)
# LICENSE_SECRET = HMAC key for license tokens + watermark hashes (min 32 chars, random).
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Until set, /api/brand & /brand.js protection stays DISABLED (server still runs).
# ALLOWED_DOMAINS = comma-separated domains allowed to load brand.js + call /api/brand.
ALLOWED_DOMAINS=localhost
LICENSE_SECRET=

# Dashboard login (Step 2 API lockdown — server/auth.js)
# ADMIN_PASSWORD seeds settings.admin_hash in the DB on first boot;
# change it later by deleting admin_hash from settings and restarting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12
