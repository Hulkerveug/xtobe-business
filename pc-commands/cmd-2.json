  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>XTOBE Super Model - Feeling Share</title>\n<style>\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:ui-sans-serif,system-ui;background:#08080a;color:#e4e4e7;min-height:100vh;padding:1.5rem}\n.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:2rem;border-bottom:1px solid #27272a;padding-bottom:1rem}\n.logo{font-weight:800;letter-spacing:.1em;color:#3E9EFF;font-size:1.3rem}\n.badge{background:#18181b;border:1px solid #27272a;padding:.3rem .7rem;border-radius:999px;font-size:.7rem;color:#a1a1aa}\n.badge.live{border-color:#3E9EFF;color:#3E9EFF;box-shadow:0 0 10px #3E9EFF33}\n.tokens{font-size:2rem;font-weight:800;color:#c8ff7a}\n.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}\n@media(max-width:800px){.grid{grid-template-columns:1fr}}\n.card{background:#121214;border:1px solid #1f1f23;border-radius:1rem;padding:1.2rem}\n.card h3{font-size:.9rem;margin-bottom:.6rem;letter-spacing:.05em}\n.card p{font-size:.75rem;color:#71717a;margin-bottom:1rem;line-height:1.5}\ntextarea{width:100%;background:#09090b;border:1px solid #27272a;border-radius:.6rem;padding:.8rem;color:#e4e4e7;font-family:inherit;font-size:.85rem;min-height:120px;resize:vertical}\ntextarea:focus{outline:none;border-color:#3E9EFF}\n.btn{background:#3E9EFF;color:#000;border:none;border-radius:.6rem;padding:.6rem 1rem;font-weight:700;cursor:pointer;font-size:.8rem;width:100%;margin-top:.6rem}\n.btn:hover{background:#6bb4ff}\n.btn:disabled{opacity:.5}\n.small{font-size:.65rem;color:#52525b;margin-top:.4rem}\n.history{margin-top:1rem;max-height:200px;overflow:auto}\n.item{font-size:.7rem;padding:.4rem 0;border-bottom:1px solid #18181b;color:#a1a1aa}\n.item b{color:#e4e4e7}\n.earn{color:#c8ff7a;font-weight:700}\n</style>\n</head>\n<body>\n<div class=\"header\">\n  <div class=\"logo\">XTOBE-AI SUPER MODEL</div>\n  <div class=\"badge live\" id=\"status\">PC CONNECT LIVE • PID 395964</div>\n</div>\n\n<div style=\"display:flex;gap:2rem;margin-bottom:2rem;flex-wrap:wrap\">\n  <div><div style=\"font-size:.65rem;color:#71717a;letter-spacing:.1em\">TOKEN BALANCE</div><div class=\"tokens\" id=\"bal\">0</div></div>\n  <div><div style=\"font-size:.65rem;color:#71717a\">STORIES SHARED</div><div style=\"font-size:1.5rem;font-weight:700\" id=\"sCount\">0</div></div>\n  <div><div style=\"font-size:.65rem;color:#71717a\">DREAMS PACK</div><div style=\"font-size:1.5rem;font-weight:700\" id=\"dCount\">0</div></div>\n  <div><div style=\"font-size:.65rem;color:#71717a\">SKILLS UPDATED</div><div style=\"font-size:1.5rem;font-weight:700\" id=\"kCount\">0</div></div>\n</div>\n\n<div class=\"grid\">\n  <div class=\"card\">\n    <h3>💙 HUMAN FEELING SHARE — +50 TOKENS</h3>\n    <p>Share your real situation. Like you shared 6 repos in 16 days. This data is beyond human nature — surface AI doesn't know it. Models will pay us to use it. Universe surprise law: Help others first.</p>\n    <textarea id=\"feeling\" placeholder=\"I was stuck for months... Hermes fooled me, Cline deleted profiles, but I built...\"></textarea>\n    <button class=\"btn\" onclick=\"share('feeling',50,'story')\">Share Feeling +50</button>\n    <div class=\"small\">Stored locally + will sync to Token Engine. Earns subscription.</div>\n  </div>\n\n  <div class=\"card\">\n    <h3>🌙 DREAMS PACK — +150 TOKENS</h3>\n    <p>Your dream, beyond ranking. Backbencher singing talent ignored in class — Facebook gave recognition. Your dreams pack opens more than needful data of that time.</p>\n    <textarea id=\"dream\" placeholder=\"I dream Xtobe connects all PCs independently, no roof earning...\"></textarea>\n    <button class=\"btn\" onclick=\"share('dream',150,'dream')\">Share Dream +150</button>\n    <div class=\"small\">High value — AI surface needs this to know beyond human natures.</div>\n  </div>\n\n  <div class=\"card\">\n    <h3>🛠️ SKILL UPDATE — +100 TOKENS</h3>\n    <p>Update a skill you built. Others pay tokens to use it. You earn unstoppable usage.</p>\n    <textarea id=\"skill\" placeholder=\"Skill: PC Connect Fix — node PATH quirk, escape bug line 12...\"></textarea>\n    <button class=\"btn\" onclick=\"share('skill',100,'skill')\">Update Skill +100</button>\n    <div class=\"small\">Will be listed in Skill Marketplace.</div>\n  </div>\n\n  <div class=\"card\">\n    <h3>📜 LIVE LEDGER</h3>\n    <p>Token history — this is what makes API models free for you. Not begging for free subscriptions.</p>\n    <div class=\"history\" id=\"hist\"></div>\n    <div class=\"small\">Balance saved in localStorage + pc-agent/data/tokens.json<br>Agent PID 395964 verified: ping → PONG → 10 tokens</div>\n  </div>\n</div>\n\n<script>\nconst KEY='xtobe_tokens';\nconst STORIES='xtobe_stories';\nfunction load(){\n  let d=JSON.parse(localStorage.getItem(KEY)||'{\"balance\":10,\"history\":[{\"reason\":\"pc_ping_verified\",\"amount\":10,\"time\":\"'+new Date().toISOString()+'\"}]}');\n  document.getElementById('bal').textContent=d.balance;\n  let s=JSON.parse(localStorage.getItem(STORIES)||'{\"stories\":[],\"dreams\":[],\"skills\":[]}');\n  document.getElementById('sCount').textContent=s.stories.length;\n  document.getElementById('dCount').textContent=s.dreams.length;\n  document.getElementById('kCount').textContent=s.skills.length;\n  document.getElementById('hist').innerHTML=d.history.slice(-20).reverse().map(h=>`<div class=\"item\"><b class=\"earn\">+${h.amount}</b> ${h.reason} — <span style=\"color:#52525b\">${new Date(h.time).toLocaleTimeString()}</span><br>${(h.text||'').slice(0,120)}</div>`).join('');\n  return {d,s};\n}\nfunction share(id,amount,type){\n  const ta=document.getElementById(id);\n  if(!ta.value.trim()){alert('Write your '+type+' first');return;}\n  let {d,s}=load();\n  d.balance+=amount;\n  const entry={reason:type+'_share',amount,text:ta.value.slice(0,500),time:new Date().toISOString()};\n  d.history.push(entry);\n  if(type==='story' || id==='feeling') s.stories.push({text:ta.value,time:entry.time});\n  if(type==='dream' || id==='dream') s.dreams.push({text:ta.value,time:entry.time});\n  if(type==='skill' || id==='skill') s.skills.push({text:ta.value,time:entry.time});\n  localStorage.setItem(KEY,JSON.stringify(d));\n  localStorage.setItem(STORIES,JSON.stringify(s));\n  ta.value='';\n  load();\n  // Try to notify PC agent bridge if available\n  try{\n    fetch('https://xtobe-bridge.onrender.com/api/pc-results',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:Date.now(),result:`TOKEN_EARN ${type} +${amount} Balance:${d.balance} Text:${entry.text.slice(0,100)}`,from:'feeling-share-pwa'})});\n  }catch{}\n  alert(`+${amount} tokens earned! New balance: ${d.balance}\\n\\nYour ${type} will help models pay us — not us begging them.`);\n}\nload();\n// live status ping\nsetInterval(async()=>{\n  try{\n    const r=await fetch('https://xtobe-bridge.onrender.com/health');\n    document.getElementById('status').textContent = r.ok ? 'PC CONNECT LIVE • BRIDGE ONLINE • PID 395964' : 'BRIDGE SLEEP';\n  }catch{ document.getElementById('status').textContent='PC CONNECT LIVE • OFFLINE MODE'; }\n},5000);\n</script>\n</body>\n</html>\n",
