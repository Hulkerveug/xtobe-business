{
  "name": "xtobe-bridge-to-home",
  "version": "1.0.0",
  "description": "XTOBE \u2014 Bridge to the Home. All chats, one home. For everyone.",
  "main": "index.js",
  "scripts": {
    "dev": "npx serve www -l 3000",
    "build": "echo 'web built'",
    "cap:init": "npx cap init XTOBE com.hulkerveug.xtobe --web-dir=www",
    "cap:add": "npx cap add android && npx cap add ios",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "bundle:android": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "serve": "^14.0.0"
  }
}